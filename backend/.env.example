# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=hr_recruitment_db

# Server Configuration
PORT=5000
NODE_ENV=production
CLIENT_ORIGIN=http://localhost:3000

# Security Configuration
JWT_SECRET=hr_super_secure_jwt_secret_key_change_me_in_production
JWT_EXPIRES_IN=7d
HR_ADMIN_SECRET=admin123

# AWS S3 Cloud Storage Configuration (Optional - IAM Role handles this automatically on EC2)
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-hr-resumes-bucket-name
# AWS_ACCESS_KEY_ID=only_needed_for_local_testing_if_not_using_local_storage
# AWS_SECRET_ACCESS_KEY=only_needed_for_local_testing_if_not_using_local_storage
