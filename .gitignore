# ============================================================
# Git Ignore Rules — HireFlow HR Recruitment & Management System
# ============================================================

# Dependencies & Package Managers
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment & Sensitive Files (NEVER COMMIT CREDENTIALS)
.env
.env.*
!.env.example
backend/.env
frontend/.env
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local

# Security Keys & SSH Certificates
*.pem
*.key
*.cer
*.crt
*.pfx
id_rsa*
secrets/

# Production Builds & Bundles
dist/
build/
frontend/build/
.parcel-cache/
.next/
out/

# Runtime Uploads & Storage (Candidate resumes & attachments)
uploads/
backend/uploads/
storage/

# Logs & Process Manager
*.log
logs/
pm2.log
.pm2/

# Personal Notes & Reference Docs
docs/
*.docx
*.doc
*.pptx
*.xlsx
HR_Recruitment_System_Round2_Interview_Prep.docx

# IDE & Operating System Caches
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
desktop.ini
*.tmp
.eslintcache

# Test Coverage
coverage/
.nyc_output/

# Database temporary/scratch scripts
backend/check_*.js
backend/test_*.js
backend/debug*.js
backend/alter_db.js
backend/clean_db.js
backend/seed.js
backend/list_tables.js
backend/check_ec_mapping.js
backend/check_employee_table.js

